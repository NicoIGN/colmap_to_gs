# Configuration complete du pipeline Panoramax (Bash de confiance).
# Copier vers config.sh, puis adapter les deux champs obligatoires ci-dessous.
# Execution locale : bash script/panoramax_to_3dgs.sh config.sh
# Slurm : bash tools/panoramax/launch.sh config.sh [--wait]
# Validation sans calcul : bash tools/panoramax/validate_config.sh config.sh slurm
#
# Les valeurs affectees sont les defauts du pipeline, pas un preset de qualite.
# "" signifie une option non forcee ; le commentaire indique alors le repli.
# OUTPUT_DIR et PANORAMAX_BBOX n'ont aucun defaut : valeurs d'exemple a remplacer.
# SPLIT_NUM_BLOCKS et TRAIN_NUM_ITER sont communs et obligatoires.
# TRAIN_SP_CAP_MAX et TRAIN_SP_PRESET sont obligatoires seulement si
# TRAIN_BACKEND=spirula. Les options TRAIN_SP_* sont ignorees par Nerfstudio.
# Ce fichier couvre les options exposees par le pipeline et son lanceur Slurm,
# pas toutes les options CLI des outils utilisables independamment.

# ============================================================================
# 0. Chemins et environnement communs
# ============================================================================

TRAIN_BACKEND="spirula" # spirula | nerfstudio ; SfM Panoramax reste Spirula
# Nerfstudio : PyTorch + NVIDIA/CUDA requis, TRAIN_MASKS_MODE=ignore si masques.
# Masques Nerfstudio : backend segmentation, modele local Mask2Former ou SegFormer.

# Obligatoire, aucun defaut. Dossier de sortie non vide, accessible en ecriture.
# Contient panoramax/ (photos, SfM, blocs), le .splat final et les references GPS.
# Slurm : choisir un chemin absolu visible depuis tous les noeuds.
OUTPUT_DIR="/chemin/vers/resultats/panoramax-paris"

# Defaut : "". Chemin executable ou commande ; vide = spirula dans PATH,
# puis ../spirula-studio/build/spirula a cote de ce depot.
SPIRULA_BIN=""

# Defaut : python3. Commande ou chemin du Python avec numpy, scipy, tqdm,
# pyproj, plyfile et Pillow (Pillow est requis si les masques sont actives).
PYTHON_BIN="python3"

# Defaut : 1. MoltenVK sur macOS : 0 = silencieux, 1 = erreurs,
# 2 = avertissements, 3 = informations, 4 = debug (entier dans [0,4]).
# Export explicite pour transmettre cette variable aux processus Spirula.
export MVK_CONFIG_LOG_LEVEL="1"

# ============================================================================
# 1. Recherche et telechargement Panoramax
# ============================================================================

# Obligatoire, aucun defaut. Ordre xmin,ymin,xmax,ymax dans le systeme indique
# ci-dessous ; quatre nombres finis, xmin<xmax et ymin<ymax.
PANORAMAX_BBOX="655418.37,6860846.96,655918.37,6861346.96"

# Defaut : 2154 (Lambert-93). Code EPSG des coordonnees de PANORAMAX_BBOX.
PANORAMAX_BBOX_EPSG="2154"

# Defaut : https://explore.panoramax.fr/api.
# URL HTTP(S) racine de l'API STAC, sans /search ni espaces.
PANORAMAX_API_URL="https://explore.panoramax.fr/api"

# Defaut : hd. Valeurs : hd (haute definition), sd, thumb (vignette).
PANORAMAX_QUALITY="hd"

# Defaut : "". Vide = toutes dates ; sinon filtre datetime STAC ISO 8601
# (instant ou intervalle debut/fin, ex. "2024-01-01T00:00:00Z/..").
PANORAMAX_DATETIME=""

# Defaut : "". Vide = aucune limite utilisateur (recherche API plafonnee
# a 10000 resultats) ; sinon entier > 0, nombre maximal de photos.
PANORAMAX_IMAGE_MAX=""

# Defaut : false. Valeurs : true|false (alias 1|0, yes|no, on|off).
# false = arret si la requete differe de celle du dataset existant.
# true = archive panoramax/ dans panoramax.replaced-DATE, puis retelecharge.
# L'archive conserve photos, SfM et blocs ; aucune suppression automatique.
PANORAMAX_REPLACE_REQUEST="false"

# ============================================================================
# 2. Reconstruction SfM et appariement
# ============================================================================
# Le SfM Panoramax est toujours calcule par Spirula, quelle que soit la valeur
# de TRAIN_BACKEND ; les options SFM_SP_* ci-dessous ne concernent que Spirula.

# --- Reglages partages du SfM ---
# Defaut : 4096. Entier > 0 ; taille maximale de travail en pixels.
SFM_MAX_IMAGE_SIZE="4096"

# Defaut : 4096. Entier > 0 ; budget de points ALIKED par image.
SFM_ALIKED_MAX_FEATURES="4096"

# --- Reglages Spirula uniquement ---
# Defaut : prefilter. Valeurs : auto|prefilter|exhaustive|sequential.
# prefilter convient aux photos Panoramax sans ordre chronologique des noms.
SFM_SP_PAIRS="prefilter"

# Defaut : aliked-n16rot.
# Valeurs : sift|aliked-n16rot|aliked-n32|loma-b128|loma-b.
SFM_SP_FEATURES="aliked-n16rot"

# Defaut : lightglue.
# Valeurs : bruteforce|lightglue|loma-b128|loma-b|loma-r|loma-l|loma-g.
# bruteforce contourne LightGlue si celui-ci plante (par exemple erreur gemm).
SFM_SP_MATCHER="lightglue"

# Defaut : "". Vide = SLURM_CPUS_PER_TASK si defini, sinon defaut Spirula.
# Sinon entier > 0 : nombre de fils CPU du SfM. Definir explicitement en local
# pour ne pas utiliser la valeur SLURM_CPUS_PER_TASK de ce fichier.
SFM_THREADS=""

# Defauts geometriques stricts : moins de points fragiles, couverture possible reduite.
# Erreur maximale en pixels d'extraction [0.1,100], verification et mapping.
SFM_MAX_ERROR="2"
# Entier [4,1000000] : inliers par paire, PAS observations minimum par point.
SFM_MIN_INLIERS="30"
# Angle de triangulation en degres : ]0,90]. Rejette les faibles parallaxes.
# Augmenter peut supprimer des batiments lointains valides.
SFM_MIN_TRI_ANGLE="3"
# Perte du bundle adjustment : huber|cauchy|trivial.
SFM_SP_BA_LOSS="huber"
# Echelle robuste ]0,1000] en pixels d'extraction (Huber delta / Cauchy c).
SFM_SP_BA_LOSS_PARAM="2"
# Spirula uniquement : exposition pour l'analyse SfM, pas la correction d'entrainement.
# Vide = option omise ; sinon auto ou correction en stops (ex. 2 ou -1).
SFM_SP_IMAGE_EXPOSURE=""
# Pour appliquer ces seuils a un SfM existant : choisir un nouvel OUTPUT_DIR.
# TRAIN_CLEAN ne refait pas le SfM. Aucun nettoyage a posteriori ici.

# Defaut : "". Vide = filtre GPS des paires desactive ; sinon nombre fini > 0
# en metres : garder les paires a distance horizontale strictement < au rayon.
# Les paires sans GPS sont gardees ; ne rajoute aucune paire.
SFM_SP_PAIR_MAX_DISTANCE=""

# ============================================================================
# 3. Calcul optionnel des masques SfM et d'entrainement
# ============================================================================
# TRAIN_MASKS seul ne filtre pas le SfM. Sortie : sfm-*/train_masks/<image>.png,
# 255 = garde, 0 = masque ; controle visuel conseille avant un long calcul.

# Defaut : off. Valeurs : on|off (alias true|false, 1|0, yes|no).
TRAIN_MASKS="off"

# Defaut : segmentation. Valeurs : segmentation|spirula.
# segmentation = SegFormer/Mask2Former Python ; spirula = SAM 3 natif Vulkan.
TRAIN_MASKS_BACKEND="segmentation"

# Defaut : "". Backend segmentation : dossier local du modele transformers,
# obligatoire si active ; affiche par tools/segmentation_masks/install.sh.
# Ne pas utiliser un checkpoint GGML ici.
TRAIN_MASKS_MODEL=""

# Defaut : "" (repli PYTHON_BIN). Backend segmentation : commande/chemin du
# Python du venv de l'installateur. Backend spirula : ignore, utilise PYTHON_BIN.
TRAIN_MASKS_PYTHON=""

# Defaut : "". Backend spirula : fichier local SAM 3 GGML obligatoire si
# active, ex. /chemin/sam3-q4_0.ggml. Requiert SS_BUILD_SAM=ON et Vulkan.
# Accepter la licence Meta avec Spirula avant un lancement non interactif.
TRAIN_MASKS_SPIRULA_MODEL=""

# Defaut : auto. Backend spirula : auto, indice GPU Vulkan (0,1,...),
# fragment du nom du GPU ou uuid:<hex>. Pas de noms cuda/mps ici.
TRAIN_MASKS_SPIRULA_DEVICE="auto"

# Logs Spirula : 1 masque les temps SAM et les messages [pcs], conserve
# avertissements/erreurs et la progression du pipeline. 0 = silencieux,
# 2 = informations et temps (defaut Spirula), 3 = detaille.
# S'applique aux processus Spirula, pas seulement aux masques.
export SS_NN_LOG=1

# Defaut : false. Mettre true uniquement apres lecture et acceptation des
# conditions SAM 3 Meta : transmet --accept-license sam3=yes pour chaque
# calcul natif SfM ou 3DGS, y compris les jobs Slurm non interactifs.
MASKS_ACCEPT_LICENSE="false"

# Defaut : sky. Liste non vide, separee par des virgules.
# segmentation : noms de labels (voir labels.txt) ou IDs numeriques ;
# insensible a la casse. sky couvre aussi les nuages dans ADE20K.
# spirula : prompts anglais libres, unis par SAM, ex. "sky,person,car".
TRAIN_MASKS_LABELS="sky"

# Defaut : auto. Valeurs : auto|ignore|empty.
# auto = empty si seulement sky, sinon ignore.
# empty = apprendre les pixels masques comme vides (ciel/flotteurs).
# ignore = exclure ces pixels de la perte (personnes/voitures sans creuser
# les facades derriere). Un seul mode pour tous les labels d'un entrainement.
TRAIN_MASKS_MODE="auto"

# Defaut : 0.5. Nombre dans [0,1].
# segmentation : seuil supplementaire sur les classes predites (0 = sans seuil).
# spirula : score minimal de detection SAM (pas une probabilite par pixel).
TRAIN_MASKS_CONFIDENCE="0.5"

# Defaut : auto. Valeurs : auto ou nombre dans [0,0.1[.
# Fraction de la diagonale de l'image pour elargir les zones masquees ;
# auto = 0 en empty, 0.002 en ignore. Meme unite pour les deux moteurs.
TRAIN_MASKS_DILATE="auto"

# Defaut : 0.8. Nombre dans ]0,1] : fraction masquee maximale par image.
# Au-dela, masque entierement blanc avec avertissement (vue conservee).
TRAIN_MASKS_MAX_FRACTION="0.8"

# Defaut : auto. Backend segmentation : auto|cpu|mps|cuda|cuda:N (N>=0).
# auto choisit CUDA, puis MPS, puis CPU. Ignore par le backend spirula.
TRAIN_MASKS_DEVICE="auto"

# --- Masques des caracteristiques SfM (avant extraction/appariement) ---
# Defaut : off. Valeurs : on|off (alias true|false, 1|0, yes|no).
# on prepare les images et calcule les masques AVANT le SfM.
SFM_MASKS="off"

# Defaut : "" = herite du parametre TRAIN_MASKS correspondant.
# BACKEND : segmentation|spirula ; PYTHON : executable Python (segmentation).
# MODEL : dossier transformers ; SPIRULA_MODEL : fichier SAM 3 GGML.
SFM_MASKS_BACKEND=""
SFM_MASKS_PYTHON=""
SFM_MASKS_MODEL=""
SFM_MASKS_SPIRULA_MODEL=""

# Defaut : "" = TRAIN_MASKS_SPIRULA_DEVICE (auto par defaut).
# Vulkan : auto, indice, fragment du nom GPU ou uuid:<hex>.
SFM_MASKS_SPIRULA_DEVICE=""

# Defaut : "" = TRAIN_MASKS_LABELS (sky par defaut).
# Liste de labels/prompts separes par des virgules ; ordre/casse ignores.
SFM_MASKS_LABELS=""

# Defaut : "" = TRAIN_MASKS_CONFIDENCE (0.5 par defaut). Nombre dans [0,1].
# Seuil supplementaire de segmentation, ou score de detection SAM.
SFM_MASKS_CONFIDENCE=""

# Defaut : 0.002. Fraction de diagonale dans [0,0.1[ ; auto = 0.002.
# Aucune notion de perte ignore/empty dans le SfM.
SFM_MASKS_DILATE="0.002"

# Defaut : "" = TRAIN_MASKS_MAX_FRACTION (0.8 par defaut). Nombre dans ]0,1].
SFM_MASKS_MAX_FRACTION=""

# Defaut : "" = TRAIN_MASKS_DEVICE (auto par defaut).
# Transformers : auto|cpu|mps|cuda|cuda:N ; ignore avec Spirula.
SFM_MASKS_DEVICE=""

# Si les deux politiques de generation sont identiques, feature_masks est
# un lien vers train_masks : un seul calcul. Des seuils/modeles differents
# imposent deux calculs meme avec des labels identiques.
# Un ancien SfM sans signature compatible est refuse : nouveau workspace requis.

# ============================================================================
# 4. Decoupage COLMAP en blocs
# ============================================================================

# Valeur initiale : 4 (defaut du lanceur de blocs). Entier >= 1 ;
# champ obligatoire du pipeline : nombre de modeles COLMAP/3DGS.
SPLIT_NUM_BLOCKS="4"

# Defaut : 0.05. Nombre dans [0,1] : fraction maximale d'images supplementaires
# par bloc pour le recouvrement. 0 = aucun recouvrement.
SPLIT_OVERLAP_MAX_FRACTION="0.05"

# ============================================================================
# 5. Entrainement 3DGS de chaque bloc
# ============================================================================

# --- TRAIN_BACKEND=spirula uniquement ---
# Preset, qualite, plafonds, croissance, robustesse et suppression des flottants
# sont des options Spirula, ignorees par Splatfacto/Nerfstudio.
# Valeur initiale : 3dgs (defaut du lanceur de blocs). Champ obligatoire.
# Valeurs : 3dgs|360-camera|in-the-wild|centered-object|hdr|synthetic|meshing.
TRAIN_SP_PRESET="3dgs"

# Defaut : "". Vide = ne pas transmettre --quality (Spirula : medium).
# Valeurs : low|medium|high|ultra. Macro de budget et duree, pas de resolution.
# Le pipeline force TRAIN_SP_CAP_MAX et TRAIN_NUM_ITER : ils restent prioritaires sur la macro.
TRAIN_SP_QUALITY=""

# Defaut : off. Valeurs : off|mild|strong.
# Robustesse de la densification aux incoherences entre photos.
# mild reduit l'influence des erreurs extremes ; strong utilise aussi une
# carte robuste sensible aux contours et un score median entre observations.
# Ne remplace pas les masques ni TRAIN_SP_FLOATER_SUPPRESSION.
TRAIN_SP_DISTRACTION_ROBUSTNESS="off"
# Corrections photometriques Spirula uniquement ; vide = defauts Spirula observes :
# true, no_crf_no_vig, false, true, ppisp. Valeurs PPISP : original|rqs|no_crf|
# no_crf_clamp|no_crf_no_vig|no_crf_no_vig_clamp.
TRAIN_SP_USE_PPISP=""
TRAIN_SP_PPISP_PARAM_TYPE=""
# Initialiser la correction d'exposition depuis les EXIF, s'ils sont disponibles.
TRAIN_SP_PPISP_EXPOSURE_FROM_EXIF=""
# PPISP ajuste exposition/couleur ; no_crf inclut le vignettage, no_crf_no_vig l'omet.
# Booléens : true|false. La grille bilaterale affine aussi les couleurs.
TRAIN_SP_USE_BILATERAL_GRID=""
# Type de grille : affine|ppisp|loglinear.
TRAIN_SP_BILAGRID_TYPE=""

# --- Parametres partages ---
# Nombre d'iterations par bloc ; utilise par Spirula et Nerfstudio.
# Valeur initiale : 30000 (defaut du lanceur de blocs). Entier > 0, obligatoire.
# Iterations par bloc ; sert aussi de suffixe sfm-TRAIN_NUM_ITER et gs-TRAIN_NUM_ITER.
TRAIN_NUM_ITER="30000"

# Valeur initiale : 1500000 (defaut du lanceur de blocs). Entier > 0, obligatoire.
# Plafond de splats par bloc ; total maximal theorique SPLIT_NUM_BLOCKS * TRAIN_SP_CAP_MAX.
TRAIN_SP_CAP_MAX="1500000"

# Defaut : "". Vide = budget TRAIN_SP_CAP_MAX ; sinon entier > 0 :
# budget du bloc = min(TRAIN_SP_CAP_MAX, nombre d'images du bloc * TRAIN_SP_SPLATS_PER_IMAGE).
TRAIN_SP_SPLATS_PER_IMAGE=""

# Defaut : "". Vide ou absent = estimation automatique bornee a [1.001, 1.05].
# Sinon nombre > 1 : valeur explicite prioritaire, sans bornage automatique.
# Multiplicateur de croissance du nombre de splats par cycle de raffinement.
# Estimation : (1 / 0.1)^(1 / cycles), avec initialisation supposee a 10 % du
# budget et cycles tous les 100 pas, strictement apres 500 et avant l'arret.
# Vise le plafond a la fin de la croissance, pas a la derniere iteration.
TRAIN_SP_GROWTH_FACTOR=""

# Defaut : "". Vide = defaut Spirula (14000) ; sinon entier >= 0.
# Pas minimal d'arret de croissance : arret effectif au maximum de
# TRAIN_SP_REFINE_STOP_ITER et TRAIN_NUM_ITER - TRAIN_SP_REFINE_STOP_NUM_ITER.
TRAIN_SP_REFINE_STOP_ITER=""

# Defaut : "". Vide = defaut Spirula (2500) ; sinon entier >= 0.
# Nombre de pas reserves a l'affinage seul en fin de calcul, sous reserve
# du minimum TRAIN_SP_REFINE_STOP_ITER. Si l'arret effectif >= TRAIN_NUM_ITER, avertissement.
TRAIN_SP_REFINE_STOP_NUM_ITER=""

# Defaut : off. Valeurs : off|mild|strong.
# Suppression native des flotteurs ; mild/strong limitent aussi leur taille
# a l'ecran. Comparer sur un bloc avant de generaliser.
TRAIN_SP_FLOATER_SUPPRESSION="off"

# Defaut : false. Valeurs : true|false (alias 1|0, yes|no, on|off).
# true = supprime uniquement les sorties GS des blocs et les reentraine.
# Ne supprime ni photos, ni SfM, ni decoupage. Necessaire pour appliquer de
# nouveaux masques a des blocs deja entraines (sinon reutilisation avertie).
TRAIN_CLEAN="false"

# --- TRAIN_BACKEND=nerfstudio uniquement ---
# Ignorés par Spirula ; Nerfstudio/Splatfacto exige PyTorch et NVIDIA/CUDA.
TRAIN_NS_TRAIN_BIN="ns-train"
TRAIN_NS_EXPORT_BIN="ns-export"
TRAIN_NS_DOWNSCALE_FACTOR="1"

# ============================================================================
# 6. Fusion, nettoyage final et export georeference
# ============================================================================

# Defaut : panoramax.splat. Nom simple non vide, sans "/", termine par .splat.
# Le fichier fusionne original reste dans <nom>.unfiltered.splat.
EXPORT_SPLAT_NAME="panoramax.splat"

# Defaut : 1.0. Nombre fini > 0 : force relative des voxels de fusion.
# Plus petit = deduplication prudente ; plus grand = deduplication accrue.
MERGE_STRENGTH="1.0"

# Defaut : contextual. Valeurs : contextual|cleangs.
# contextual = filtres geometriques ci-dessous ; cleangs = nettoyage ciel
# multivues via segmentation (CUDA, modele et venv propres a Clean-GS).
POSTPROCESS_CLEANER="contextual"

# --- Nettoyage contextual (ignore si POSTPROCESS_CLEANER=cleangs) ---

# Defaut : diagnostic. Valeurs : diagnostic|apply|off.
# diagnostic = garde tout et exporte les candidats dans <nom>.rejected.splat ;
# apply = retire les candidats ; off = desactive le test contextuel.
# Le recadrage sparse ci-dessous est independant et peut rester actif.
POSTPROCESS_FILTER_MODE="diagnostic"

# Defaut : 10. Nombre fini > 1, sans unite.
# Grand axe / mediane des grands axes voisins ; le depassement seul ne retire
# rien : il faut aussi une position peripherique et un faible support.
POSTPROCESS_FILTER_SIZE_FACTOR="10"

# Defaut : apply. Valeurs : apply|diagnostic|off.
# Bbox orientee des points sparse aux quantiles 0.5 % / 99.5 % :
# apply = retire les centres hors bbox ; diagnostic = signale ; off = desactive.
# Pas de decoupe aux frontieres internes des blocs ; seul le centre est teste.
POSTPROCESS_SPARSE_BBOX_MODE="apply"

# Defaut : 0.05. Nombre >= 0, sans unite.
# Marge de bbox = fraction du plus grand cote ; 0 = aucune marge.
POSTPROCESS_SPARSE_BBOX_MARGIN="0.05"

# --- Nettoyage cleangs (ignore si POSTPROCESS_CLEANER=contextual) ---

# Defaut : "" (repli PYTHON_BIN). Commande/chemin du Python du venv Clean-GS,
# affiche par bash tools/clean_gs/install.sh.
CLEANGS_PYTHON=""

# Defaut : "". Dossier local du modele de segmentation obligatoire si
# POSTPROCESS_CLEANER=cleangs ; affiche par l'installateur Clean-GS.
CLEANGS_MODEL=""

# Defaut : diagnostic. Valeurs : diagnostic|apply.
# diagnostic = signale sans supprimer ; apply = applique le nettoyage.
CLEANGS_MODE="diagnostic"

# Defaut : 2. Entier > 0 : nombre minimal de vues ciel concordantes.
CLEANGS_MIN_VIEWS="2"

# Defaut : 0.9. Nombre dans ]0.5,1] : confiance minimale du label ciel.
CLEANGS_SKY_CONFIDENCE="0.9"

# Defaut : 0.2. Nombre dans [0,1[ : fraction maximale de splats supprimables.
# En apply, le depassement provoque un arret, pas une suppression tronquee.
CLEANGS_MAX_REMOVAL_FRACTION="0.2"

# ============================================================================
# 7. Execution Slurm (ignore en local, sauf repli de SFM_THREADS)
# ============================================================================
# Un GPU pour la preparation, un par bloc, fusion sans GPU sauf si cleangs.
# Chaque job dispose des CPU/RAM/duree ci-dessous. Chemins et config partages.

# Defaut : jean-zellou. Nom de partition GPU existante ; adapter au cluster.
SLURM_PARTITION="jean-zellou"

# Defaut : 16. Entier > 0 : CPU alloues par job (preparation, bloc, fusion).
# Sert aussi de repli a SFM_THREADS, meme en local si defini dans la config.
SLURM_CPUS_PER_TASK="16"

# Defaut : 64G. Entier >= 0 avec suffixe optionnel K|M|G|T (casse indifferente).
# Sans suffixe : Mo Slurm ; 0 = memoire du noeud selon le site. RAM, pas VRAM.
SLURM_MEMORY="64G"

# Defaut : 48:00:00. Syntaxe Slurm : minutes, minutes:secondes, hh:mm:ss,
# jours-hh[:mm[:ss]], ou UNLIMITED ; minutes/secondes dans [0,59] apres ":".
# Duree maximale par job, soumise aux limites de la partition.
SLURM_TIME_LIMIT="48:00:00"

# Defaut : "". Vide = gpu:1 sans type ; sinon type GPU Slurm,
# lettres/chiffres/"_"/"-" uniquement (ex. a100), sans ":".
SLURM_GPU_TYPE=""

# Defaut : "" (repli SPLIT_NUM_BLOCKS). Sinon entier > 0 : blocs simultanes au plus.
# 1 = sequentiel ; une valeur > SPLIT_NUM_BLOCKS n'ajoute aucun bloc.
# Le cluster peut reduire le parallelisme effectif.
SLURM_BLOCK_PARALLELISM=""

# Defaut : "". Compte de facturation Slurm ; vide = defaut du site.
SLURM_ACCOUNT=""

# Defaut : "". Qualite de service Slurm ; vide = defaut du site.
SLURM_QOS=""

# Defaut : "". Chemin absolu d'un script Bash de confiance visible des noeuds,
# source avant Conda (ex. module load Vulkan) ; vide = aucun script.
SLURM_ENV_SETUP=""

# Defaut : "". Nom/chemin d'un environnement Conda ; vide = environnement herite.
SLURM_CONDA_ENV=""

# Defaut : "". Racine Conda ; vide = conda info --base.
# Utilise uniquement si SLURM_CONDA_ENV est non vide.
SLURM_CONDA_BASE=""
