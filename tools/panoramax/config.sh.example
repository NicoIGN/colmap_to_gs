# Exemple de configuration pour tools/panoramax/run_pipeline.sh.
# Copier ce modèle vers config.sh avant de le personnaliser.
# Copier ce fichier, renseigner les chemins et valeurs, puis passer sa copie
# au lanceur : bash tools/panoramax/run_pipeline.sh /chemin/vers/ma_config.sh
# Vérification sans calcul ni soumission :
# bash tools/panoramax/validate_config.sh /chemin/vers/ma_config.sh slurm

# Emplacement de tous les résultats intermédiaires et du .splat final.
# Le sous-dossier panoramax/ est réservé aux photos téléchargées par ce script.
OUTPUT_DIR="/Users/mon_nom/Documents/panoramax-paris"

# Emprise Lambert-93 EPSG:2154, ordre xmin,ymin,xmax,ymax, en mètres.
BBOX_LAMBERT93="655418.37,6860846.96,655918.37,6861346.96"

# URL racine de l'API Panoramax, sans /search.
PANORAMAX_API_URL="https://explore.panoramax.fr/api"

# Qualité de l'asset à télécharger : hd, sd ou thumb.
PANORAMAX_QUALITY="hd"

# Intervalle STAC facultatif, début/fin ISO 8601 ; vide = toutes dates.
PANORAMAX_DATETIME=""

# Nombre maximal de photos téléchargées ; vide = jusqu'au plafond API de 10000.
PANORAMAX_IMAGE_MAX="400"

# Exécutable Spirula ; vide = recherche dans PATH puis voisin spirula-studio.
SPIRULA_BIN=""

# Python avec numpy, scipy, tqdm, pyproj et plyfile installés.
PYTHON_BIN="python3"

# Nombre de blocs COLMAP et Gaussian Splats entraînés.
NUM_BLOCKS="4"

# Nombre d'itérations Spirula par bloc.
NUM_ITER="30000"

# Plafond dur de Gaussians par bloc ; le total possible est NUM_BLOCKS × CAP_MAX.
# Spirula (MCMC) fait croître le nombre de splats jusqu'au budget : l'atteindre
# est normal. Le budget réel se règle donc par SPLATS_PER_IMAGE ci-dessous.
CAP_MAX="3000000"

# Préréglage « croissance sobre » (laisser vide = valeur par défaut Spirula).
# Budget par bloc = min(CAP_MAX, images du bloc × SPLATS_PER_IMAGE).
SPLATS_PER_IMAGE="2000"
# Multiplicateur du nombre de splats tous les 100 pas (Spirula : 1.05).
GROWTH_FACTOR="1.03"
# Fraction de NUM_ITER après laquelle on n'ajoute plus de splats ; le reste de
# l'entraînement affine les splats existants (Spirula : jusqu'à max(14000, N-2500)).
GROWTH_STOP_FRACTION="0.6"
# Nettoyage des flottants de Spirula : off, mild, strong. mild/strong limitent
# aussi la taille à l'écran des splats ; comparer d'abord sur un bloc.
FLOATER_SUPPRESSION="off"

# Préréglage d'entraînement Spirula, par exemple 3dgs ou in-the-wild.
TRAIN_PRESET="3dgs"

# Résolution maximale de travail pour l'extraction SfM Spirula.
SFM_MAX_IMAGE_SIZE="4096"

# Nombre maximal de points ALIKED détectés par image.
SFM_ALIKED_MAX_FEATURES="4096"

# Stratégie de sélection des paires Spirula : auto, exhaustive, sequential,
# prefilter. Pour des photos Panoramax sans ordre de noms, prefilter est adapté.
SFM_PAIRS="prefilter"

# Extracteur et apparieur SfM. Si LightGlue plante avec une erreur gemm,
# essayer SFM_MATCHER="bruteforce" sans changer les images ni la bbox.
SFM_FEATURES="aliked-n16rot"
SFM_MATCHER="lightglue"

# Nombre de fils SfM ; vide = CPU Slurm alloués, sinon défaut Spirula en local.
SFM_THREADS=""

# Rayon GPS maximal des paires avant reconstruction, en mètres.
# Vide = désactivé (SfM auto habituel). Exemple "30" : conserver seulement
# les paires à distance strictement < 30 m ; conserver les paires sans GPS.
# Filtre les correspondances après appariement, sans ajout de paires ni patch
# Spirula. Distance géodésique horizontale WGS84 des métadonnées Panoramax.
SFM_PAIR_MAX_DISTANCE=""

# Fraction maximale d'images ajoutées en recouvrement par le découpeur COLMAP.
OVERLAP_MAX_FRACTION="0.05"

# Force le réentraînement de tous les blocs en supprimant uniquement leurs
# dossiers GS, pas le téléchargement, le SfM ni le découpage. true ou false.
CLEAN_GS="false"

# Nom du fichier .splat fusionné dans OUTPUT_DIR.
SPLAT_NAME="panoramax.splat"

# Force relative des voxels lors de la fusion des scènes alignées.
# Plus petit = fusion plus prudente, plus grand = davantage de déduplication.
SPLAT_MERGE_STRENGTH="1.0"

# Filtre global après fusion (pas de découpe aux frontières internes des blocs).
# diagnostic : garde tout, exporte les candidats dans *.rejected.splat.
# apply : retire ces candidats ; off : aucun test géométrique.
# L'original fusionné est toujours conservé dans *.unfiltered.splat.
SPLAT_FILTER_MODE="diagnostic"

# Grand axe / médiane des grands axes voisins, sans unité.
# Un dépassement seul ne supprime rien : périphérie et faible support requis.
SPLAT_FILTER_SIZE_FACTOR="10"

# Recadrage sur la bbox des points 3D sparse (sfm-*/sparse/0/points3D.bin).
# Boîte orientée sur les axes principaux des points, bornée aux quantiles
# 0,5 %/99,5 % ; marge = fraction du plus grand côté (sans unité).
# Seul le centre du splat est testé : une grande route centrée dedans reste.
# apply (défaut) : retire les splats hors bbox ; diagnostic : les signale ; off.
SPLAT_SPARSE_BBOX_MODE="apply"
SPLAT_SPARSE_BBOX_MARGIN="0.05"

# Paramètres facultatifs pour bash tools/panoramax/launch.sh config.sh.
# Partition GPU du cluster (adapter au site).
SLURM_PARTITION="jean-zellou"

# Nombre de CPU alloués à chaque job (préparation, chaque bloc, fusion).
SLURM_CPUS_PER_TASK="16"

# Mémoire RAM par job (pas la VRAM GPU), syntaxe Slurm.
SLURM_MEMORY="64G"

# Durée maximale de chaque job, syntaxe Slurm.
SLURM_TIME_LIMIT="48:00:00"

# Type GPU Slurm facultatif, par exemple a100 ; vide = gpu:1 sans type.
# Un GPU pour la préparation puis un GPU par bloc ; fusion sans GPU.
SLURM_GPU_TYPE=""

# Maximum de blocs entraînés simultanément ; vide = NUM_BLOCKS.
# Exemple : 4 blocs parallèles = jusqu'à 4 GPU et 4 fois la RAM/CPU par job.
# 1 = entraînement séquentiel ; Slurm peut réduire le parallélisme effectif.
SLURM_BLOCK_PARALLELISM=""

# Compte de facturation et qualité de service Slurm ; vide = défaut du site.
SLURM_ACCOUNT=""
SLURM_QOS=""

# Script Bash de confiance sourcé sur le nœud avant Conda (module load, Vulkan).
# Vide = aucun script ; utiliser un chemin absolu accessible depuis le nœud.
SLURM_ENV_SETUP=""

# Environnement Conda à activer sur le nœud ; vide = environnement hérité.
SLURM_CONDA_ENV=""

# Racine d'installation Conda ; vide = conda info --base.
# Utilisé uniquement si SLURM_CONDA_ENV est renseigné.
SLURM_CONDA_BASE=""
